# Server
NODE_ENV=development
PORT=5000
CLIENT_URL=http://localhost:5174

# Database
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/<db-name>

# JWT (use long, random strings — e.g. `openssl rand -hex 32`)
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d

# Cookies (use a long, random string)
COOKIE_SECRET=

# Cloudinary (product/review image uploads)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Rate limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100

# Mail (forgot password — no provider wired up yet, reset tokens are logged in dev)
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=
MAIL_FROM=no-reply@cartify.com

# Razorpay — Settings > API Keys in the Razorpay Dashboard (use TEST mode
# keys while developing). RAZORPAY_KEY_ID is also returned to the frontend
# (GET /api/v1/payments/config) — it's meant to be public. Never expose
# RAZORPAY_KEY_SECRET or RAZORPAY_WEBHOOK_SECRET to the client.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Settings > Webhooks > (your webhook) > Secret — see the README section on
# setting up the webhook for exactly what this needs to match.
RAZORPAY_WEBHOOK_SECRET=
